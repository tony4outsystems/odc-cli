{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ODC: Discover",
      "type": "go",
      "request": "launch",
      "args": [
        "discover"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/odc"
    },
    {
      "name": "ODC: Latest Revision",
      "type": "go",
      "request": "launch",
      "args": [
        "latest-revision",
        "--asset",
        "${input:asset}"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/odc"
    },
    {
      "name": "ODC: Validate",
      "type": "go",
      "request": "launch",
      "args": [
        "validate",
        "--asset",
        "${input:asset}",
        "--env",
        "${input:environment}"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/odc"
    },
    {
      "name": "ODC: Build Deploy",
      "type": "go",
      "request": "launch",
      "args": [
        "deploy",
        "--asset",
        "${input:asset}",
        "--env",
        "${input:environment}"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/odc"
    },
    {
      "name": "ODC: Producer Graph",
      "type": "go",
      "request": "launch",
      "args": [
        "producer-graph",
        "--output",
        "output/producer-graph-vscode.mmd",
        "--asset",
        "${input:asset}"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/odc"
    }
  ],
  "inputs": [
    {
      "id": "asset",
      "type": "promptString",
      "description": "Asset name or key"
    },
    {
      "id": "environment",
      "type": "promptString",
      "description": "Environment name or key"
    }
  ]
}
