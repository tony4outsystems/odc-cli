{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ODC: Help",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "run",
          "--bin=odc"
        ]
      },
      "args": [],
      "envFile": "${workspaceFolder}/.env"

    },
    
    {
      "name": "ODC: Discover",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin=odc"],
        "filter": {
          "name": "odc",
          "kind": "bin"
        }
      },
      "args": ["discover"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "ODC: Latest Revision",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin=odc"],
        "filter": {
          "name": "odc",
          "kind": "bin"
        }
      },
      "args": [
        "latest-revision",
        "--asset",
        "${input:asset}"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "ODC: Build Deploy",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin=odc"],
        "filter": {
          "name": "odc",
          "kind": "bin"
        }
      },
      "args": [
        "deploy",
        "--asset",
        "${input:asset}",
        "--env",
        "${input:environment}"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "ODC: Producer Graph",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin=odc"],
        "filter": {
          "name": "odc",
          "kind": "bin"
        }
      },
      "args": [
        "producer-graph",
        "--output",
        "output/producer-graph-vscode.mmd",
        "--asset",
        "${input:asset}"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    }
  ],
  "inputs": [
    {
      "id": "asset",
      "type": "promptString",
      "description": "Asset name or key"
    },
    {
      "id": "environment",
      "type": "promptString",
      "description": "Environment name or key"
    }
  ]
}
