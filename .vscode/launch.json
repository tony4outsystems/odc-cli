{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ODC: Discover",
      "type": "debugpy",
      "request": "launch",
      "module": "odc_cli",
      "args": ["discover"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ODC: Latest Revision",
      "type": "debugpy",
      "request": "launch",
      "module": "odc_cli",
      "args": ["latest-revision"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ODC: Validate",
      "type": "debugpy",
      "request": "launch",
      "module": "odc_cli",
      "args": ["validate"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ODC: Build Deploy",
      "type": "debugpy",
      "request": "launch",
      "module": "odc_cli",
      "args": ["deploy"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ODC: Producer Graph",
      "type": "debugpy",
      "request": "launch",
      "module": "odc_cli",
      "args": ["producer-graph", "--output", "output/producer-graph-vscode.mmd"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
