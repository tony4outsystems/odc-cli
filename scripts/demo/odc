#!/usr/bin/env bash
# Fake `odc` binary used only to record scripts/demo/demo.tape with VHS.
# Prints canned, realistic output for a fixed set of commands — never calls
# the real API or reads real credentials.
set -euo pipefail

case "$*" in
  "list-apps --search eGov")
    printf 'name              key        type\n'
    printf 'eGovPortal        3f9a-21e   WebApplication\n'
    printf 'eGovCore          8b1c-77d   LowCodeLibrary\n'
    ;;

  "validate --asset eGovPortal --env Production")
    printf 'Resolving asset and environment...\n'
    sleep 0.6
    printf '\033[32m\xE2\x9C\x93 eGovPortal (rev 14) is visible in Production\033[0m\n'
    ;;

  "deploy --asset eGovPortal --env Production")
    printf 'Building revision 14 (Release)...\n'
    sleep 1.0
    printf 'Deploying to Production...\n'
    sleep 0.8
    printf '\033[32m\xE2\x9C\x93 eGovPortal rev 14 deployed to Production\033[0m\n'
    ;;

  *)
    echo "fake odc: unhandled demo command: $*" >&2
    exit 1
    ;;
esac
