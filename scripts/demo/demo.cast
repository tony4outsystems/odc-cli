[0.606, "o", "Grant an application role to a user\r\n\r\n\u001b[1m\u001b[4mUsage:\u001b[0m \u001b[1modc grant-role\u001b[0m [OPTIONS] <ASSET> <ROLE> <USER>\r\n\r\n\u001b[1m\u001b[4mArguments:\u001b[0m\r\n  <ASSET>  App the role belongs to (name or key)\r\n  <ROLE>   Role name or key\r\n  <USER>   User key or email\r\n\r\n\u001b[1m\u001b[4mOptions:\u001b[0m\r\n      \u001b[1m--json\u001b[0m           Output in JSON format\r\n      \u001b[1m--color\u001b[0m <COLOR>  Control color output [default: auto]\r\n  \u001b[1m-n\u001b[0m, \u001b[1m--no-resolve\u001b[0m     Disable resolution of external keys (environment names, role names, etc.) in user-friendly output\r\n  \u001b[1m-h\u001b[0m, \u001b[1m--help\u001b[0m           Print help\r\n"]
